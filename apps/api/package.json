{
  "name": "@agentclear/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir test --exclude **/*.integration.test.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@agentclear/chain": "workspace:*",
    "@agentclear/config": "workspace:*",
    "@agentclear/compute": "workspace:*",
    "@agentclear/db": "workspace:*",
    "@agentclear/domain": "workspace:*",
    "@agentclear/storage": "workspace:*",
    "@fastify/rate-limit": "11.2.0",
    "fastify": "5.12.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@agentclear/contracts": "workspace:*",
    "drizzle-orm": "0.45.2",
    "viem": "2.55.19"
  }
}
