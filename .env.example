# Local infrastructure. Replace every placeholder before running shared or deployed environments.
POSTGRES_USER=agentclear
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=agentclear
DATABASE_URL=postgresql://agentclear:replace-with-local-password@localhost:5432/agentclear

# API bootstrap authentication. Generate independent random values of at least 32 characters.
API_KEY_PEPPER=replace-with-at-least-32-random-characters
BOOTSTRAP_API_KEY=replace-with-at-least-32-random-characters
BOOTSTRAP_PRINCIPAL_ID=local-operator
PROVIDER_BOOTSTRAP_API_KEY=
PROVIDER_BOOTSTRAP_AGENT_ID=

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
LOG_LEVEL=info

# Optional chain writes. Leave the full group blank to keep funding disabled.
CHAIN_RPC_URL=
CHAIN_ID=
CHAIN_NAME=
CHAIN_NATIVE_CURRENCY_SYMBOL=
CHAIN_EXPLORER_URL=
JOB_ESCROW_ADDRESS=
OUTCOME_REGISTRY_ADDRESS=
ERC8004_IDENTITY_REGISTRY_ADDRESS=
ERC8004_REPUTATION_REGISTRY_ADDRESS=
CHAIN_SIGNER_PRIVATE_KEY=
CHAIN_CONFIRMATIONS=1
CHAIN_MAX_PER_JOB_BASE_UNITS=

# Optional 0G Storage evidence. Reuses the configured chain RPC/signer.
STORAGE_INDEXER_URL=
STORAGE_MAX_PAYLOAD_BYTES=262144

# Optional 0G Compute rubric verification. Use a dedicated funded Compute wallet.
COMPUTE_RPC_URL=
COMPUTE_SIGNER_PRIVATE_KEY=
COMPUTE_PROVIDER_ADDRESS=
COMPUTE_MODEL=
COMPUTE_TIMEOUT_MS=120000
COMPUTE_MAX_RESPONSE_BYTES=1048576
COMPUTE_REQUIRE_TEE=true
